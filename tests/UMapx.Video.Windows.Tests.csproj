<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0067;CS0618;CS0612</NoWarn>
    <LibraryPackageVersion Condition="'$(LibraryPackageVersion)' == ''">8.0.0.1</LibraryPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedLibrary)' != 'true'">
    <ProjectReference Include="../sources/UMapx.Video.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedLibrary)' == 'true'">
    <PackageReference Include="UMapx.Video.Windows" Version="$(LibraryPackageVersion)" />
  </ItemGroup>
</Project>
